# PaperForge environment example.
# The backend does NOT auto-load .env files. Load it into your shell before starting:
#   set -a; . ./.env; set +a
# Then start the backend: uvicorn app.main:app --host 127.0.0.1 --port 8000

# ============ REQUIRED ============cd

# Postgres with pgvector. This matches docker-compose.yml (docker compose up -d db).
DATABASE_URL=postgresql://paperforge:paperforge@127.0.0.1:5432/paperforge
# If you use an embedded local pgserver instead, its URI looks like:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
#
# The app will NOT create the pgvector extension itself. After starting the db, run once:
#   docker compose exec db psql -U paperforge -d paperforge -c 'CREATE EXTENSION IF NOT EXISTS vector'
# Without it the backend stops with "pgvector is not enabled".

# Generation model key (NVIDIA hosted). Drafting, reading, planning, edits, Q&A answers.
NVIDIA_API_KEY=paste-your-nvidia-key

# Embeddings key (Voyage, the default embedding provider).
VOYAGE_API_KEY=paste-your-voyage-key

# Reviewer model key (Groq, used only for claim review and Q&A verification).
GROQ_API_KEY=paste-your-groq-key

# ============ REVIEWER SPLIT (tested configuration) ============

# Generation model. This is the default; shown for clarity.
PAPERFORGE_MODEL=nvidia/nvidia/nemotron-3.5-lightning-30b-a3b

# Reviewer model, routed through the bounded proxy below. Empty means same as generation model.
PAPERFORGE_REVIEW_MODEL=groq/openai/gpt-oss-120b

# Bounded reviewer transport. Start BEFORE any backend call:
#   python3 tools/bounded-review-proxy.py 19441 proxy.log 30 https api.groq.com 443
# Args: port, log file, request cap, scheme, upstream host, upstream port.
PAPERFORGE_REVIEW_BASE_URL=http://127.0.0.1:19441/openai/v1

# ============ HOSTED CALL GATES (all default to disabled) ============
# Each hosted provider is off until explicitly enabled.

PAPERFORGE_HOSTED_CALLS=enabled      # master gate for hosted model calls
PAPERFORGE_ANSWER_CALLS=enabled      # Q&A answer generation
# "add source by URL" ingestion. DISABLED by default: all three lines must be
# set together, and only AFTER you have verified your Firecrawl account's actual
# free credit allowance. Until then the app refuses URL ingestion with
# "Firecrawl disabled or free-credit scope unverified" (safe, intended).
PAPERFORGE_FIRECRAWL_CALLS=disabled
FIRECRAWL_API_KEY=paste-your-firecrawl-key
PAPERFORGE_FIRECRAWL_FREE_VERIFIED=disabled   # set enabled only after verifying the free allowance
# PAPERFORGE_FIRECRAWL_CREDIT_CAP=20   # app-side lifetime credit cap (default 20)
PAPERFORGE_OPENALEX_CALLS=enabled    # source discovery (OpenAlex). OPENALEX_API_KEY optional.

# ============ DATABASE INIT ============

PAPERFORGE_DB_SCHEMA=paperforge
PAPERFORGE_DB_INITIALIZE=enabled     # first run only: creates the schema. Remove or set disabled after.

# ============ OPTIONAL (defaults shown) ============

# opencode CLI. Default: found on PATH. Tested with opencode-ai@1.19.5 (npm i -g opencode-ai@1.19.5).
# OPENCODE_BIN=/path/to/opencode

# PAPERFORGE_DATA=./data                    # project data directory
# PAPERFORGE_PUBLIC_URL=http://127.0.0.1:8000
# PAPERFORGE_CONTACT_EMAIL=you@example.com  # sent to OpenAlex/arXiv as courtesy

# Timeouts and run bounds (tested run used 95 / 85 / 6):
# PAPERFORGE_DRAFT_TIMEOUT=100
# PAPERFORGE_READ_TIMEOUT=90
# PAPERFORGE_MAX_SEGMENTS_PER_RUN=40
# PAPERFORGE_MAX_SOURCES=8
# PAPERFORGE_MAX_FIX_ITERATIONS=4

# Embeddings (defaults shown; "local" provider is an explicit dev opt-in):
# PAPERFORGE_EMBED_PROVIDER=voyage
# PAPERFORGE_EMBED_MODEL=voyage-4
# PAPERFORGE_EMBED_TOKEN_BUDGET=2000000     # per backend process; guards the free allowance

# Review knobs:
# PAPERFORGE_REVIEW_MODEL_OPTIONS=          # JSON object merged into the reviewer model options
# PAPERFORGE_REVIEW_SLICE_SECONDS=0         # 0 = no time slicing
# PAPERFORGE_REVIEW_NEW_ATTEMPT=            # leave empty; setting it forces one fresh review attempt of an unresolved span

# Scanned-PDF fallback (off unless configured):
# UNSTRUCTURED_MODE=scanned
# UNSTRUCTURED_API_KEY=
# UNSTRUCTURED_API_URL=https://transform.unstructured.io/api/v2
# (PAPERFORGE_UNSTRUCTURED_FREE_VERIFIED exists in config but is not read anywhere; omitted.)

# Hosted frontend only. Comma-separated EXACT origins (scheme://host[:port], no wildcard, no path, no trailing
# slash) allowed to call the API from a browser. localhost:5173 and :8000 are always allowed. This is an origin
# check, not authentication: anyone who can reach the backend URL with a non-browser client can still use it.
# PAPERFORGE_ALLOWED_ORIGINS=https://paperforge-web.up.railway.app

# ============ FRONTEND ============
# Local dev: no env vars needed. The Vite dev server proxies /api to 127.0.0.1:8000 (web/vite.config.ts).
# Hosted frontend: set VITE_API_BASE=https://<backend origin> when running `npm run build` (build-time).
# Word export needs pandoc >= 2.11 on PATH (tested: 3.1.11.1); paper builds need pdflatex/bibtex.
